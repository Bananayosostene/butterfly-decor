generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  password         String
  failedAttempts   Int       @default(0)
  lockedAt         DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
}

model Session {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  token     String    @unique
  adminId   String    @db.ObjectId
  admin     AdminUser @relation(fields: [adminId], references: [id])
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model Booking {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  phone         String
  eventDate     DateTime
  selectedItems String[]
  status        String   @default("NEW")
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

model Category {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String           @unique
  description String?
  imageUrl    String?
  /// "DECOR" for decor categories (shown under /decor); missing or "COLLECTION" for the main collection.
  kind        String?
  /// File name of the tab icon in /public, chosen from lib/category-icons.ts.
  icon        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CollectionItem[]
  images      CategoryImage[]
}

model CategoryImage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])
  imageUrl   String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([categoryId, order])
}

model SiteSettings {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  heroVideoUrl String?
  /// Background photo of the homepage decor section.
  decorImageUrl String?
  updatedAt    DateTime @updatedAt
}

model CollectionItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  imageUrl    String
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([categoryId, createdAt])
}

model StyleIdea {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model DeviceVisit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userAgent String
  ip        String?
  device    String?
  browser   String?
  os        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ItemLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId    String   @db.ObjectId
  visitorId String
  createdAt DateTime @default(now())

  @@unique([itemId, visitorId])
}

model ItemComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId    String   @db.ObjectId
  visitorId String
  name      String
  text      String
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([visitorId, createdAt])
}

// ── Vendors and site accounts (separate from AdminUser) ──────────────────────────────

model VendorCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  /// File name of the icon in /public, chosen from lib/category-icons.ts.
  icon      String?
  createdAt DateTime @default(now())
  vendors   User[]
}

model User {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  email            String          @unique
  name             String
  phone            String?
  password         String?
  googleId         String?
  /// null until the "Are you a vendor?" question is answered, then "CLIENT" or "VENDOR".
  role             String?
  // Vendor profile (only used when role is VENDOR)
  businessName     String?
  location         String?
  about            String?
  coverUrl         String?
  vendorCategoryId String?         @db.ObjectId
  vendorCategory   VendorCategory? @relation(fields: [vendorCategoryId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         UserSession[]
  items            VendorItem[]

  @@index([role, vendorCategoryId])
}

model UserSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VendorItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  vendorId    String   @db.ObjectId
  vendor      User     @relation(fields: [vendorId], references: [id])
  imageUrl    String
  description String?
  /// Admin can switch an item off; inactive items are hidden from the public pages.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([vendorId, createdAt])
}

/// One step of the homepage butterfly animation: two photos (left and right wing) and a title.
model ButterflySlide {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  leftImageUrl  String
  rightImageUrl String
  createdAt     DateTime @default(now())
}
